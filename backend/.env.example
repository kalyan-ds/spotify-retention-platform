# API
PROJECT_NAME="Spotify Retention Platform API"
API_V1_STR="/api/v1"
VERSION="1.0.0"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="spotify_retention"
POSTGRES_PORT=5432

# Security Placeholder
SECRET_KEY="placeholder_secret_key_for_development_do_not_use_in_prod"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Logging
LOG_LEVEL="DEBUG"
